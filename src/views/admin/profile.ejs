<%
  const currentData = typeof formData !== 'undefined' && formData ? formData : (user || {});
  const validationMap = typeof fieldErrorMap !== 'undefined' && fieldErrorMap ? fieldErrorMap : {};
  const getFieldError = (name) => validationMap[name] || '';
  const hasError = (name) => Boolean(getFieldError(name));
  const profileAvatar = currentData.avatar || '/images/default-avatar.png';
%>

<div class="settings-content">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h4 mb-1">My Profile</h1>
      <p class="text-muted mb-0">Update your admin profile details and change your password when needed.</p>
    </div>
  </div>

  <form method="POST" action="/admin/profile">
    <%- include('../partials/csrf') %>
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Profile Details</h5>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Name</label>
                <input type="text" class="form-control <%= hasError('name') ? 'is-invalid' : '' %>" name="name" value="<%= currentData.name || '' %>" required minlength="2" maxlength="100" data-trim-required="true" data-no-html-tags="true" data-trim-message="Name is required." data-no-html-message="Name cannot contain HTML or script tags.">
                <% if (getFieldError('name')) { %><div class="invalid-feedback"><%= getFieldError('name') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">Username</label>
                <input type="text" class="form-control" value="<%= currentData.username || '' %>" readonly>
                <small class="text-muted">Username is fixed for admin login identity.</small>
              </div>
              <div class="col-md-6">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" value="<%= currentData.email || '' %>" readonly>
              </div>
              <div class="col-md-6">
                <label class="form-label">Role</label>
                <input type="text" class="form-control" value="<%= currentData.role || 'admin' %>" readonly>
              </div>
              <div class="col-12">
                <label class="form-label">Avatar URL / Path</label>
                <input type="text" class="form-control <%= hasError('avatar') ? 'is-invalid' : '' %>" name="avatar" value="<%= currentData.avatar || '' %>" placeholder="/images/default-avatar.png" data-validate-asset-url="true" data-asset-url-message="Avatar must be a valid URL or site-relative path.">
                <% if (getFieldError('avatar')) { %><div class="invalid-feedback"><%= getFieldError('avatar') %></div><% } %>
                <small class="text-muted">You can use a local path like `/images/default-avatar.png` or a public image URL.</small>
                <div class="mt-2 d-flex flex-wrap gap-2 align-items-center" data-cloudinary-upload-widget data-target="[name='avatar']" data-preview="#profileAvatarPreview" data-status="#avatarStatus">
                  <input type="file" class="form-control form-control-sm" accept="image/*" data-upload-file>
                  <button type="button" class="btn btn-outline-primary btn-sm" data-upload-button>
                    <i class="bi bi-upload me-1"></i>Upload Avatar
                  </button>
                  <small class="text-muted" id="avatarStatus">Upload an avatar image to Cloudinary.</small>
                </div>
              </div>
              <div class="col-12">
                <label class="form-label">Bio</label>
                <textarea class="form-control <%= hasError('bio') ? 'is-invalid' : '' %>" name="bio" rows="4" maxlength="500" data-no-html-tags="true" data-no-html-message="Bio cannot contain HTML or script tags."><%= currentData.bio || '' %></textarea>
                <% if (getFieldError('bio')) { %><div class="invalid-feedback"><%= getFieldError('bio') %></div><% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0">Security</h5>
          </div>
          <div class="card-body">
            <div class="alert alert-info" role="alert">
              Leave password fields blank if you do not want to change your password.
            </div>
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label">Current Password</label>
                <input type="password" class="form-control <%= hasError('currentPassword') ? 'is-invalid' : '' %>" name="currentPassword" autocomplete="current-password" data-required-if="#newPassword" data-required-if-message="Current password is required when changing password.">
                <% if (getFieldError('currentPassword')) { %><div class="invalid-feedback"><%= getFieldError('currentPassword') %></div><% } %>
              </div>
              <div class="col-md-4">
                <label class="form-label">New Password</label>
                <input type="password" class="form-control <%= hasError('newPassword') ? 'is-invalid' : '' %>" name="newPassword" id="newPassword" autocomplete="new-password" minlength="6" maxlength="72">
                <% if (getFieldError('newPassword')) { %><div class="invalid-feedback"><%= getFieldError('newPassword') %></div><% } %>
              </div>
              <div class="col-md-4">
                <label class="form-label">Confirm Password</label>
                <input type="password" class="form-control <%= hasError('confirmPassword') ? 'is-invalid' : '' %>" name="confirmPassword" data-match="#newPassword" data-match-message="Confirm password must match the new password." data-required-if="#newPassword" data-required-if-message="Please confirm your new password." autocomplete="new-password" minlength="6" maxlength="72">
                <% if (getFieldError('confirmPassword')) { %><div class="invalid-feedback"><%= getFieldError('confirmPassword') %></div><% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Profile Preview</h5>
          </div>
          <div class="card-body text-center">
            <img src="<%= profileAvatar %>" alt="<%= currentData.name || currentData.username || 'Admin' %>" class="rounded-circle border mb-3" width="120" height="120" style="object-fit: cover;" id="profileAvatarPreview">
            <h5 class="mb-1"><%= currentData.name || currentData.username || 'Admin' %></h5>
            <p class="text-muted mb-1"><%= currentData.email || '' %></p>
            <p class="small text-muted mb-0"><%= currentData.bio || 'No bio added yet.' %></p>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Username</span>
              <strong><%= currentData.username || '-' %></strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Role</span>
              <strong><%= currentData.role || 'admin' %></strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Points</span>
              <strong><%= currentData.totalPoints || 0 %></strong>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-muted">Status</span>
              <strong class="text-success">Active</strong>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-body d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg">Save Profile</button>
            <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>
