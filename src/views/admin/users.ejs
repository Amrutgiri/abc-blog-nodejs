<div class="users-content">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h4 mb-1">Users</h1>
      <p class="text-muted mb-0">Manage member, author, and admin accounts.</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-datatable="true">
          <thead>
            <tr>
              <th>Name</th>
              <th>Username</th>
              <th>Email</th>
              <th>Role</th>
              <th>Points</th>
              <th>Status</th>
              <th>Joined</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(function(account) { %>
                <tr>
                  <td class="fw-semibold"><%= account.name || '-' %></td>
                  <td><%= account.username %></td>
                  <td><%= account.email %></td>
                  <td><span class="badge bg-light text-dark"><%= account.role %></span></td>
                  <td><%= account.totalPoints || 0 %></td>
                  <td>
                    <span class="badge bg-<%= account.isActive ? 'success' : 'secondary' %>"><%= account.isActive ? 'Active' : 'Disabled' %></span>
                  </td>
                  <td><%= new Date(account.createdAt).toLocaleDateString() %></td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <a href="/admin/users/<%= account._id %>/edit" class="btn btn-outline-primary">Edit</a>
                      <button type="button" class="btn btn-outline-danger btn-delete" data-type="user" data-id="<%= account._id %>" <%= account.role === 'admin' ? 'disabled' : '' %>>Delete</button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-5">No users found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% if (totalPages > 1) { %>
    <nav class="mt-4">
      <ul class="pagination justify-content-center">
        <% if (page > 1) { %>
          <li class="page-item"><a class="page-link" href="?page=<%= page - 1 %>">Previous</a></li>
        <% } %>
        <% for (var i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= page === i ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
        <% } %>
        <% if (page < totalPages) { %>
          <li class="page-item"><a class="page-link" href="?page=<%= page + 1 %>">Next</a></li>
        <% } %>
      </ul>
    </nav>
  <% } %>
</div>
