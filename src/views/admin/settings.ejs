<%
  const currentData = typeof formData !== 'undefined' && formData ? formData : (settings || {});
  const validationMap = typeof fieldErrorMap !== 'undefined' && fieldErrorMap ? fieldErrorMap : {};
  const getFieldError = (name) => validationMap[name] || '';
  const hasError = (name) => Boolean(getFieldError(name));
  const logoPreview = currentData.siteLogoUrl || '/images/headerlogo.png';
  const faviconPreview = currentData.faviconUrl || '/images/favicon%20(2).png';
%>

<div class="settings-content">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h4 mb-1">Site Settings</h1>
      <p class="text-muted mb-0">Manage the website name, brand assets, social links, and public contact details.</p>
    </div>
  </div>

  <form method="POST" action="/admin/settings">
    <%- include('../partials/csrf') %>
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Brand Identity</h5>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Website Name</label>
                <input type="text" class="form-control <%= hasError('siteName') ? 'is-invalid' : '' %>" name="siteName" value="<%= currentData.siteName || '' %>" required minlength="2" maxlength="120" data-trim-required="true" data-no-html-tags="true" data-trim-message="Website name is required." data-no-html-message="Website name cannot contain HTML or script tags.">
                <% if (getFieldError('siteName')) { %><div class="invalid-feedback"><%= getFieldError('siteName') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">Logo URL / Path</label>
                <input type="text" class="form-control <%= hasError('siteLogoUrl') ? 'is-invalid' : '' %>" name="siteLogoUrl" value="<%= currentData.siteLogoUrl || '' %>" placeholder="/images/headerlogo.png" data-validate-asset-url="true" data-asset-url-message="Logo must be a valid URL or site-relative path.">
                <% if (getFieldError('siteLogoUrl')) { %><div class="invalid-feedback"><%= getFieldError('siteLogoUrl') %></div><% } %>
                <small class="text-muted">Use a public image URL or a path inside `/public` like `/images/headerlogo.png`.</small>
              </div>
              <div class="col-md-6">
                <label class="form-label">Favicon URL / Path</label>
                <input type="text" class="form-control <%= hasError('faviconUrl') ? 'is-invalid' : '' %>" name="faviconUrl" value="<%= currentData.faviconUrl || '' %>" placeholder="/images/favicon (2).png" data-validate-asset-url="true" data-asset-url-message="Favicon must be a valid URL or site-relative path.">
                <% if (getFieldError('faviconUrl')) { %><div class="invalid-feedback"><%= getFieldError('faviconUrl') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">Contact Email</label>
                <input type="email" class="form-control <%= hasError('contactEmail') ? 'is-invalid' : '' %>" name="contactEmail" value="<%= currentData.contactEmail || '' %>" autocomplete="email" data-no-html-tags="true" data-no-html-message="Contact email cannot contain HTML or script tags.">
                <% if (getFieldError('contactEmail')) { %><div class="invalid-feedback"><%= getFieldError('contactEmail') %></div><% } %>
              </div>
              <div class="col-12">
                <label class="form-label">Website Description</label>
                <textarea class="form-control <%= hasError('siteDescription') ? 'is-invalid' : '' %>" name="siteDescription" rows="3" required minlength="10" maxlength="255" data-trim-required="true" data-no-html-tags="true" data-trim-message="Website description is required." data-no-html-message="Website description cannot contain HTML or script tags."><%= currentData.siteDescription || '' %></textarea>
                <% if (getFieldError('siteDescription')) { %><div class="invalid-feedback"><%= getFieldError('siteDescription') %></div><% } %>
              </div>
              <div class="col-12">
                <label class="form-label">Footer About Text</label>
                <textarea class="form-control <%= hasError('footerAbout') ? 'is-invalid' : '' %>" name="footerAbout" rows="4" maxlength="300" data-no-html-tags="true" data-no-html-message="Footer about text cannot contain HTML or script tags."><%= currentData.footerAbout || '' %></textarea>
                <% if (getFieldError('footerAbout')) { %><div class="invalid-feedback"><%= getFieldError('footerAbout') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">Support Phone</label>
                <input type="text" class="form-control <%= hasError('supportPhone') ? 'is-invalid' : '' %>" name="supportPhone" value="<%= currentData.supportPhone || '' %>" placeholder="+91 98765 43210" data-no-html-tags="true" data-no-html-message="Support phone cannot contain HTML or script tags.">
                <% if (getFieldError('supportPhone')) { %><div class="invalid-feedback"><%= getFieldError('supportPhone') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">Copyright Text</label>
                <input type="text" class="form-control <%= hasError('copyrightText') ? 'is-invalid' : '' %>" name="copyrightText" value="<%= currentData.copyrightText || '' %>" placeholder="All rights reserved." maxlength="120" data-no-html-tags="true" data-no-html-message="Copyright text cannot contain HTML or script tags.">
                <% if (getFieldError('copyrightText')) { %><div class="invalid-feedback"><%= getFieldError('copyrightText') %></div><% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Social Links</h5>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">WhatsApp Channel Link</label>
                <input type="url" class="form-control <%= hasError('whatsappChannelUrl') ? 'is-invalid' : '' %>" name="whatsappChannelUrl" value="<%= currentData.whatsappChannelUrl || '' %>" placeholder="https://whatsapp.com/channel/..." data-validate-url="true" data-url-message="WhatsApp channel link must be a valid URL.">
                <% if (getFieldError('whatsappChannelUrl')) { %><div class="invalid-feedback"><%= getFieldError('whatsappChannelUrl') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">Facebook</label>
                <input type="url" class="form-control <%= hasError('facebookUrl') ? 'is-invalid' : '' %>" name="facebookUrl" value="<%= currentData.facebookUrl || '' %>" placeholder="https://facebook.com/..." data-validate-url="true" data-url-message="Facebook link must be a valid URL.">
                <% if (getFieldError('facebookUrl')) { %><div class="invalid-feedback"><%= getFieldError('facebookUrl') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">Instagram</label>
                <input type="url" class="form-control <%= hasError('instagramUrl') ? 'is-invalid' : '' %>" name="instagramUrl" value="<%= currentData.instagramUrl || '' %>" placeholder="https://instagram.com/..." data-validate-url="true" data-url-message="Instagram link must be a valid URL.">
                <% if (getFieldError('instagramUrl')) { %><div class="invalid-feedback"><%= getFieldError('instagramUrl') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">X / Twitter</label>
                <input type="url" class="form-control <%= hasError('xUrl') ? 'is-invalid' : '' %>" name="xUrl" value="<%= currentData.xUrl || '' %>" placeholder="https://x.com/..." data-validate-url="true" data-url-message="X link must be a valid URL.">
                <% if (getFieldError('xUrl')) { %><div class="invalid-feedback"><%= getFieldError('xUrl') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">YouTube</label>
                <input type="url" class="form-control <%= hasError('youtubeUrl') ? 'is-invalid' : '' %>" name="youtubeUrl" value="<%= currentData.youtubeUrl || '' %>" placeholder="https://youtube.com/..." data-validate-url="true" data-url-message="YouTube link must be a valid URL.">
                <% if (getFieldError('youtubeUrl')) { %><div class="invalid-feedback"><%= getFieldError('youtubeUrl') %></div><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">LinkedIn</label>
                <input type="url" class="form-control <%= hasError('linkedinUrl') ? 'is-invalid' : '' %>" name="linkedinUrl" value="<%= currentData.linkedinUrl || '' %>" placeholder="https://linkedin.com/..." data-validate-url="true" data-url-message="LinkedIn link must be a valid URL.">
                <% if (getFieldError('linkedinUrl')) { %><div class="invalid-feedback"><%= getFieldError('linkedinUrl') %></div><% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Live Preview</h5>
          </div>
          <div class="card-body text-center">
            <img src="<%= logoPreview %>" alt="Site logo preview" class="img-fluid mb-3" style="max-height: 110px; object-fit: contain;">
            <h5 class="mb-2"><%= currentData.siteName || 'Website Name' %></h5>
            <p class="text-muted small mb-3"><%= currentData.siteDescription || 'Website description preview' %></p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
              <% if (currentData.whatsappChannelUrl) { %>
                <a href="<%= currentData.whatsappChannelUrl %>" target="_blank" class="btn btn-sm btn-outline-success">WhatsApp Channel</a>
              <% } %>
              <% if (currentData.facebookUrl) { %><a href="<%= currentData.facebookUrl %>" target="_blank" class="btn btn-sm btn-outline-primary">Facebook</a><% } %>
              <% if (currentData.instagramUrl) { %><a href="<%= currentData.instagramUrl %>" target="_blank" class="btn btn-sm btn-outline-danger">Instagram</a><% } %>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Brand Assets</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label">Favicon Preview</label>
              <div class="d-flex align-items-center gap-3">
                <img src="<%= faviconPreview %>" alt="Favicon preview" width="48" height="48" class="rounded border">
                <div>
                  <small class="text-muted d-block">Used for browser tabs and bookmarks.</small>
                </div>
              </div>
            </div>
            <div class="alert alert-info mb-0" role="alert">
              WhatsApp channel link, social links, and logo URLs will be shown on the public website immediately after save.
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-body d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg">Save Settings</button>
            <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>
