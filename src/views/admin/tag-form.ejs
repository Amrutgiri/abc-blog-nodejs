

<div class="tag-form-content">
  <form method="POST" action="/admin/tags">
    <%- include('../partials/csrf') %>
    <div class="card border-0 shadow-sm" style="max-width: 600px;">
      <div class="card-header bg-white">
        <h5 class="mb-0">New Tag</h5>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label for="name" class="form-label">Name</label>
          <input type="text" class="form-control" id="name" name="name" required minlength="2" maxlength="50" data-trim-required="true" data-trim-message="Tag name is required.">
        </div>
      </div>
      <div class="card-footer bg-white">
        <button type="submit" class="btn btn-primary">Save Tag</button>
        <a href="/admin/tags" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </div>
  </form>
</div>
