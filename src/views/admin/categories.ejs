

<div class="categories-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Categories</h4>
    <a href="/admin/categories/new" class="btn btn-primary">
      <i class="bi bi-plus-circle me-2"></i>New Category
    </a>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-3">
      <div class="table-responsive">
        <table class="table table-hover mb-0" data-datatable="true">
          <thead>
            <tr>
              <th>Name</th>
              <th>Slug</th>
              <th>Posts</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(function(category) { %>
                <tr>
                  <td class="fw-semibold"><%= category.name %></td>
                  <td><code><%= category.slug %></code></td>
                  <td><%= category.postCount || 0 %></td>
                  <td>
                    <span class="badge bg-<%= category.isActive ? 'success' : 'secondary' %>">
                      <%= category.isActive ? 'Active' : 'Inactive' %>
                    </span>
                  </td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <a href="/admin/categories/<%= category._id %>/edit" class="btn btn-outline-primary">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <button class="btn btn-outline-danger btn-delete" data-id="<%= category._id %>" data-type="category">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center text-muted py-4">No categories found</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
