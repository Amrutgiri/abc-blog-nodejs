<div class="quiz-admin-page">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h4 mb-1">Quizzes</h1>
      <p class="text-muted mb-0">Create, publish, and track aptitude quizzes.</p>
    </div>
    <a href="/admin/quizzes/new" class="btn btn-primary">
      <i class="bi bi-plus-circle me-2"></i>New Quiz
    </a>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="stat-card bg-white rounded-4 p-4 h-100">
        <p class="text-muted mb-1">Total Quizzes</p>
        <h3 class="mb-0 fw-bold"><%= total %></h3>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card bg-white rounded-4 p-4 h-100">
        <p class="text-muted mb-1">Published</p>
        <h3 class="mb-0 fw-bold"><%= quizzes.filter(function(quiz) { return quiz.status === 'published'; }).length %></h3>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card bg-white rounded-4 p-4 h-100">
        <p class="text-muted mb-1">Drafts</p>
        <h3 class="mb-0 fw-bold"><%= quizzes.filter(function(quiz) { return quiz.status === 'draft'; }).length %></h3>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-datatable="true">
          <thead>
            <tr>
              <th>Title</th>
              <th>Category</th>
              <th>Questions</th>
              <th>Duration</th>
              <th>Status</th>
              <th>Published</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (quizzes && quizzes.length > 0) { %>
              <% quizzes.forEach(function(quiz) { %>
                <tr>
                  <td>
                    <div class="fw-semibold"><%= quiz.title %></div>
                    <small class="text-muted"><%= quiz.slug %></small>
                  </td>
                  <td><span class="badge bg-light text-dark"><%= quiz.category %></span></td>
                  <td><%= quiz.totalQuestions %></td>
                  <td><%= quiz.duration %> min</td>
                  <td>
                    <span class="badge bg-<%= quiz.status === 'published' ? 'success' : 'secondary' %>"><%= quiz.status %></span>
                  </td>
                  <td><%= quiz.publishedAt ? new Date(quiz.publishedAt).toLocaleDateString() : '-' %></td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <a href="/admin/quizzes/<%= quiz._id %>/edit" class="btn btn-outline-primary">Edit</a>
                      <a href="/admin/quizzes/<%= quiz._id %>/attempts" class="btn btn-outline-secondary">Attempts</a>
                      <button type="button" class="btn btn-outline-danger btn-delete" data-type="quiz" data-id="<%= quiz._id %>">Delete</button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-5">No quizzes created yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% if (totalPages > 1) { %>
    <nav aria-label="Quiz pagination" class="mt-4">
      <ul class="pagination justify-content-center">
        <% if (page > 1) { %>
          <li class="page-item"><a class="page-link" href="?page=<%= page - 1 %>">Previous</a></li>
        <% } %>
        <% for (var i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= page === i ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
        <% } %>
        <% if (page < totalPages) { %>
          <li class="page-item"><a class="page-link" href="?page=<%= page + 1 %>">Next</a></li>
        <% } %>
      </ul>
    </nav>
  <% } %>
</div>
