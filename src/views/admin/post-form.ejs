

<div class="post-form-content">
  <form method="POST" action="<%= post ? '/admin/posts/' + post._id + '?_method=PUT' : '/admin/posts' %>" id="postForm">
    <%- include('../partials/csrf') %>
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Content</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label for="title" class="form-label">Title</label>
              <input type="text" class="form-control" id="title" name="title" value="<%= post ? post.title : '' %>" required maxlength="200">
            </div>

            <div class="mb-3">
              <label for="excerpt" class="form-label">Excerpt</label>
              <textarea class="form-control" id="excerpt" name="excerpt" rows="3" maxlength="500"><%= post ? (post.excerpt || '') : '' %></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label">Content</label>
              <div id="editorjs" aria-label="Post content editor"></div>
              <input type="hidden" name="content" id="content" value="<%= post && post.content ? JSON.stringify(post.content) : JSON.stringify({ blocks: [{ type: 'paragraph', data: { text: '' } }] }) %>" data-validate-editor-content="true" data-editor-message="Please add post content before saving.">
              <small class="text-muted d-block mt-2">Use the editor below to build the post content. The content is saved as structured JSON.</small>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0">SEO Settings</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label for="seo[metaTitle]" class="form-label">Meta Title</label>
              <input type="text" class="form-control" id="seo[metaTitle]" name="seo[metaTitle]" value="<%= post && post.seo ? post.seo.metaTitle : '' %>" maxlength="70">
              <small class="text-muted">Recommended: 50-60 characters</small>
            </div>
            <div class="mb-3">
              <label for="seo[metaDescription]" class="form-label">Meta Description</label>
              <textarea class="form-control" id="seo[metaDescription]" name="seo[metaDescription]" rows="2" maxlength="160"><%= post && post.seo ? post.seo.metaDescription : '' %></textarea>
              <small class="text-muted">Recommended: 150-160 characters</small>
            </div>
            <div class="mb-3">
              <label for="seo[metaKeywords]" class="form-label">Meta Keywords</label>
              <input type="text" class="form-control" id="seo[metaKeywords]" name="seo[metaKeywords]" value="<%= post && post.seo ? post.seo.metaKeywords : '' %>" placeholder="keyword1, keyword2, keyword3">
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Publish</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label for="status" class="form-label">Status</label>
              <select class="form-select" id="status" name="status" required>
                <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Draft</option>
                <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
                <option value="scheduled" <%= post && post.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="scheduledAt" class="form-label">Schedule Publish</label>
              <input type="datetime-local" class="form-control" id="scheduledAt" name="scheduledAt" value="<%= post && post.scheduledAt ? new Date(post.scheduledAt).toISOString().slice(0, 16) : '' %>">
            </div>

            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="featured" name="featured" <%= post && post.featured ? 'checked' : '' %>>
              <label class="form-check-label" for="featured">Featured post</label>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-primary">Save</button>
              <% if (post) { %>
                <a href="/blog/<%= post.slug %>" class="btn btn-outline-secondary" target="_blank">View Post</a>
              <% } %>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Category</h5>
          </div>
            <div class="card-body">
              <select class="form-select" id="category" name="category" required>
                <option value="">Select Category</option>
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat._id %>" <%= post && post.category && post.category._id.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
                <% }); %>
              </select>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Tags</h5>
          </div>
          <div class="card-body">
            <select class="form-select" id="tags" name="tags" multiple>
              <% tags.forEach(function(tag) { %>
                <option value="<%= tag._id %>" <%= post && post.tags && post.tags.some(t => t._id.toString() === tag._id.toString()) ? 'selected' : '' %>><%= tag.name %></option>
              <% }); %>
            </select>
            <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
          </div>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0">Featured Image</h5>
          </div>
          <div class="card-body">
            <input type="text" class="form-control mb-2" id="featuredImage" name="featuredImage" value="<%= post ? post.featuredImage : '' %>" placeholder="Image URL will appear here after upload">
            <input type="file" class="form-control mb-2" id="featuredImageFile" accept="image/*">
            <div class="d-flex gap-2 align-items-center mb-2">
              <button type="button" class="btn btn-outline-primary btn-sm" id="uploadFeaturedImage">
                <i class="bi bi-upload me-1"></i>Upload to Cloudinary
              </button>
              <small class="text-muted" id="featuredImageStatus">Choose an image file to upload.</small>
            </div>
            <img
              src="<%= post && post.featuredImage ? post.featuredImage : '/images/placeholder.jpg' %>"
              alt="Featured"
              class="img-fluid rounded"
              id="featuredImagePreview"
            >
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<div id="postEditorConfig"
  data-existing="<%= encodeURIComponent(JSON.stringify(post && post.content ? post.content : null)) %>"
  data-csrf="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"></div>

<script src="https://cdn.jsdelivr.net/npm/@editorjs/editorjs@2.28.0"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/header@2.6.2"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/list@1.8.0"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/code@2.8.0"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/quote@2.4.0"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/image@2.3.0"></script>
<script src="/js/admin-post-form.js"></script>
