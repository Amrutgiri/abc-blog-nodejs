<%
  const existingQuestions = quizQuestions && quizQuestions.length > 0 ? quizQuestions : (questions || []);
  const selectedBlogPosts = quiz && quiz.blogPosts ? quiz.blogPosts.map(function(post) { return post._id.toString(); }) : [];
%>

<div class="quiz-admin-page">
  <form method="POST" action="<%= quiz ? '/admin/quizzes/' + quiz._id + '?_method=PUT' : '/admin/quizzes' %>" id="quizForm">
    <%- include('../partials/csrf') %>
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Quiz Details</h5>
            <a href="/admin/quizzes" class="btn btn-sm btn-outline-secondary">Back</a>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label">Title</label>
              <input type="text" name="title" class="form-control" value="<%= quiz ? quiz.title : '' %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea name="description" class="form-control" rows="3"><%= quiz ? (quiz.description || '') : '' %></textarea>
            </div>
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label">Category</label>
                <select name="category" class="form-select" required>
                  <option value="quantitative" <%= quiz && quiz.category === 'quantitative' ? 'selected' : '' %>>Quantitative</option>
                  <option value="logical" <%= quiz && quiz.category === 'logical' ? 'selected' : '' %>>Logical</option>
                  <option value="verbal" <%= quiz && quiz.category === 'verbal' ? 'selected' : '' %>>Verbal</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Duration (minutes)</label>
                <input type="number" name="duration" class="form-control" min="1" max="240" value="<%= quiz ? quiz.duration : 15 %>" required>
              </div>
              <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="status" class="form-select" required>
                  <option value="draft" <%= quiz && quiz.status === 'draft' ? 'selected' : '' %>>Draft</option>
                  <option value="published" <%= quiz && quiz.status === 'published' ? 'selected' : '' %>>Published</option>
                  <option value="unpublished" <%= quiz && quiz.status === 'unpublished' ? 'selected' : '' %>>Unpublished</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Questions</h5>
            <button type="button" class="btn btn-sm btn-outline-primary" id="addQuizQuestion">
              <i class="bi bi-plus-circle me-1"></i>Add Question
            </button>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label">Bulk Import JSON</label>
              <textarea class="form-control" name="bulkQuestions" rows="5" placeholder='[{"question":"...","options":["A","B","C","D"],"correctAnswer":"A","explanation":"..."}]' data-validate-json="true" data-json-message="Please paste valid JSON in the bulk import field."></textarea>
              <small class="text-muted">If this field is filled, it will override the manual question entries.</small>
            </div>

            <div id="quizQuestionsList" class="quiz-questions-editor">
              <% (existingQuestions.length > 0 ? existingQuestions : [{ question: '', options: ['', '', '', ''], correctAnswer: '', explanation: '' }]).forEach(function(question, index) { %>
                <div class="quiz-question-editor card border mb-3" data-index="<%= index %>">
                  <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <strong>Question <%= index + 1 %></strong>
                    <button type="button" class="btn btn-sm btn-outline-danger remove-quiz-question">Remove</button>
                  </div>
                  <div class="card-body">
                    <div class="mb-3">
                      <label class="form-label">Question</label>
                      <textarea class="form-control" name="questions[<%= index %>][question]" rows="3" required><%= question.question || '' %></textarea>
                    </div>
                    <div class="row g-3">
                      <% for (var optionIndex = 0; optionIndex < 4; optionIndex++) { %>
                        <div class="col-md-6">
                          <label class="form-label">Option <%= optionIndex + 1 %></label>
                          <input type="text" class="form-control" name="questions[<%= index %>][options][]" value="<%= question.options && question.options[optionIndex] ? question.options[optionIndex] : '' %>" required>
                        </div>
                      <% } %>
                    </div>
                    <div class="row g-3 mt-1">
                      <div class="col-md-6">
                        <label class="form-label">Correct Answer</label>
                        <input type="text" class="form-control" name="questions[<%= index %>][correctAnswer]" value="<%= question.correctAnswer || '' %>" required>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Explanation</label>
                        <input type="text" class="form-control" name="questions[<%= index %>][explanation]" value="<%= question.explanation || '' %>">
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Settings</h5>
          </div>
          <div class="card-body">
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" name="negativeMarking" id="negativeMarking" <%= quiz && quiz.negativeMarking ? 'checked' : '' %>>
              <label class="form-check-label" for="negativeMarking">Enable negative marking</label>
            </div>
            <div class="mb-3">
              <label class="form-label">Negative Marking Value</label>
              <input type="number" step="0.25" min="0" name="negativeMarkingValue" class="form-control" value="<%= quiz ? quiz.negativeMarkingValue : 0 %>">
            </div>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" name="randomizeQuestions" id="randomizeQuestions" <%= !quiz || quiz.randomizeQuestions ? 'checked' : '' %>>
              <label class="form-check-label" for="randomizeQuestions">Shuffle questions</label>
            </div>
            <div class="mb-3">
              <label class="form-label">Instructions</label>
              <textarea class="form-control" name="instructions" rows="4"><%= quiz ? (quiz.instructions || '') : '' %></textarea>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Linked Blog Posts</h5>
          </div>
          <div class="card-body">
            <select name="blogPosts" class="form-select" multiple size="8">
              <% posts.forEach(function(post) { %>
                <option value="<%= post._id %>" <%= selectedBlogPosts.includes(post._id.toString()) ? 'selected' : '' %>><%= post.title %></option>
              <% }); %>
            </select>
            <small class="text-muted">Hold Ctrl/Cmd to pick multiple posts.</small>
          </div>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-body d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg">Save Quiz</button>
            <% if (quiz) { %>
              <a href="/quizzes/<%= quiz.slug %>" class="btn btn-outline-secondary" target="_blank">Preview Quiz</a>
              <a href="/admin/quizzes/<%= quiz._id %>/attempts" class="btn btn-outline-secondary">View Attempts</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<script src="/js/admin-quiz-form.js"></script>
