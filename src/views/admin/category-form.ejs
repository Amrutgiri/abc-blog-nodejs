

<div class="category-form-content">
  <form method="POST" action="<%= category ? '/admin/categories/' + category._id + '?_method=PUT' : '/admin/categories' %>">
    <%- include('../partials/csrf') %>
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0"><%= category ? 'Edit' : 'New' %> Category</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label for="name" class="form-label">Name</label>
              <input type="text" class="form-control" id="name" name="name" value="<%= category ? category.name : '' %>" required minlength="2" maxlength="100">
            </div>
            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" id="description" name="description" rows="3" maxlength="500"><%= category ? (category.description || '') : '' %></textarea>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="isActive" name="isActive" <%= !category || category.isActive ? 'checked' : '' %>>
              <label class="form-check-label" for="isActive">Active</label>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0">Image</h5>
          </div>
          <div class="card-body">
            <input type="text" class="form-control mb-2" id="image" name="image" value="<%= category ? category.image : '' %>" placeholder="Enter image URL">
            <% if (category && category.image) { %>
              <img src="<%= category.image %>" alt="Category" class="img-fluid rounded">
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4">
      <button type="submit" class="btn btn-primary">Save Category</button>
      <a href="/admin/categories" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>
