<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error <%= statusCode %> - Admin Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-login">
  <div class="login-container">
    <div class="login-card text-center">
      <p class="admin-eyebrow mb-2">Admin Panel</p>
      <h1 class="display-4 fw-bold text-danger mb-3"><%= statusCode %></h1>
      <h2 class="h5 mb-4"><%= error %></h2>
      <div class="d-grid gap-2">
        <a href="/admin" class="btn btn-primary">Go to Dashboard</a>
        <a href="/admin/login" class="btn btn-outline-secondary">Back to Login</a>
      </div>
    </div>
  </div>
</body>
</html>
