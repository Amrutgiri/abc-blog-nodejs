<%
  const adminUser = typeof user !== 'undefined' ? user : null;
  const siteBrand = typeof siteSettings !== 'undefined' && siteSettings ? siteSettings : {};
%>
<aside class="admin-sidebar">
  <div class="sidebar-brand">
    <a href="/admin" class="brand-link">
      <span class="brand-mark brand-mark-image">
        <img src="<%= siteBrand.faviconUrl || '/images/favicon%20(2).png' %>" alt="<%= siteBrand.siteName || 'Aptitude Booster Club' %>" class="brand-mark-logo">
      </span>
      <span class="brand-copy">
        <strong><%= siteBrand.siteName || 'Aptitude Booster' %></strong>
        <small>Admin Console</small>
      </span>
    </a>
  </div>

  <div class="sidebar-profile">
    <a href="/admin/profile" class="text-decoration-none">
      <img src="<%= (adminUser && adminUser.avatar) || '/images/default-avatar.png' %>" alt="Admin" class="sidebar-avatar" width="44" height="44">
    </a>
    <div>
      <strong><a href="/admin/profile" class="text-white text-decoration-none"><%= adminUser ? adminUser.username : 'Admin' %></a></strong>
      <small><%= adminUser ? adminUser.email : 'Administrator' %></small>
    </div>
  </div>

  <div class="sidebar-scroll">
    <nav class="sidebar-nav">
      <p class="sidebar-label">Navigation</p>
      <ul class="nav flex-column">
      <li class="nav-item">
        <a href="/admin" class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>">
          <i class="bi bi-grid"></i>
          <span>Dashboard</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/profile" class="nav-link <%= currentPage === 'profile' ? 'active' : '' %>">
          <i class="bi bi-person"></i>
          <span>My Profile</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/posts" class="nav-link <%= currentPage === 'posts' ? 'active' : '' %>">
          <i class="bi bi-file-earmark-text"></i>
          <span>Posts</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/categories" class="nav-link <%= currentPage === 'categories' ? 'active' : '' %>">
          <i class="bi bi-folder"></i>
          <span>Categories</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/tags" class="nav-link <%= currentPage === 'tags' ? 'active' : '' %>">
          <i class="bi bi-tags"></i>
          <span>Tags</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/quizzes" class="nav-link <%= currentPage === 'quizzes' ? 'active' : '' %>">
          <i class="bi bi-patch-question"></i>
          <span>Quizzes</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/contacts" class="nav-link <%= currentPage === 'contacts' ? 'active' : '' %>">
          <i class="bi bi-envelope"></i>
          <span>Contacts</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/subscribers" class="nav-link <%= currentPage === 'subscribers' ? 'active' : '' %>">
          <i class="bi bi-send-check"></i>
          <span>Subscribers</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/settings" class="nav-link <%= currentPage === 'settings' ? 'active' : '' %>">
          <i class="bi bi-gear"></i>
          <span>Settings</span>
        </a>
      </li>
      <% if (adminUser && adminUser.role === 'admin') { %>
        <li class="nav-item">
          <a href="/admin/users" class="nav-link <%= currentPage === 'users' ? 'active' : '' %>">
              <i class="bi bi-people"></i>
              <span>Users</span>
            </a>
          </li>
        <% } %>
      </ul>
    </nav>

    <div class="sidebar-footer">
      <a href="/" class="nav-link" target="_blank">
        <i class="bi bi-box-arrow-up-right"></i>
        <span>View Site</span>
      </a>
      <form method="POST" action="/admin/logout" class="m-0">
        <%- include('./csrf') %>
        <button type="submit" class="nav-link nav-link-danger border-0 bg-transparent w-100 text-start">
          <i class="bi bi-box-arrow-left"></i>
          <span>Logout</span>
        </button>
      </form>
    </div>
  </div>
</aside>
