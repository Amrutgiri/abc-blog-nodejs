<footer class="site-footer bg-dark text-white py-5">
  <div class="container">
    <%
      const siteBrand = typeof siteSettings !== 'undefined' && siteSettings ? siteSettings : {};
    %>
    <div class="row g-4">
      <div class="col-lg-4">
        <h5 class="mb-3"><%= siteBrand.siteName || 'Aptitude Booster Club' %></h5>
        <p class="text-white-50 mb-3"><%= siteBrand.footerAbout || siteBrand.siteDescription || 'Your go-to resource for aptitude tests, competitive exams, and skill development. Learn, practice, and succeed.' %></p>
        <div class="d-flex gap-3">
          <% if (siteBrand.facebookUrl) { %><a href="<%= siteBrand.facebookUrl %>" class="text-white" target="_blank" rel="noopener"><span class="visually-hidden">Facebook</span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg></a><% } %>
          <% if (siteBrand.instagramUrl) { %><a href="<%= siteBrand.instagramUrl %>" class="text-white" target="_blank" rel="noopener"><span class="visually-hidden">Instagram</span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.281.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a><% } %>
          <% if (siteBrand.whatsappChannelUrl) { %><a href="<%= siteBrand.whatsappChannelUrl %>" class="text-white" target="_blank" rel="noopener"><span class="visually-hidden">WhatsApp Channel</span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163A11.872 11.872 0 0 1 0 11.945C-.031 5.335 5.345-.038 11.945 0 18.548.038 24 5.456 24 12.054c0 6.601-5.452 12.019-12.055 11.981a11.88 11.88 0 0 1-5.688-1.438L.057 24zm6.597-3.807a9.865 9.865 0 0 0 5.285 1.515h.004c5.466 0 9.916-4.447 9.916-9.918 0-5.465-4.45-9.914-9.917-9.914C6.473 1.876 2.025 6.324 2.025 11.79c0 1.897.534 3.75 1.544 5.343l-1.008 3.687 3.756-.983zm11.387-5.73c-.308-.154-1.828-.902-2.112-1.006-.283-.104-.492-.155-.701.154-.209.308-.806 1.006-.988 1.213-.181.208-.363.232-.67.078-.308-.154-1.304-.48-2.484-1.533-.918-.818-1.538-1.828-1.719-2.136-.181-.308-.019-.475.136-.628.14-.139.308-.362.463-.543.154-.181.205-.308.308-.513.103-.205.051-.384-.024-.538-.077-.154-.701-1.688-.96-2.312-.252-.605-.509-.523-.701-.533l-.597-.01c-.205 0-.538.077-.821.384-.283.308-1.08 1.056-1.08 2.571s1.105 2.98 1.259 3.186c.154.205 2.17 3.312 5.258 4.646.736.318 1.31.508 1.757.65.737.235 1.408.202 1.939.123.592-.088 1.828-.746 2.086-1.468.257-.723.257-1.343.18-1.469-.074-.123-.283-.197-.59-.351z"/></svg></a><% } %>
        </div>
      </div>
      <div class="col-lg-2 col-md-4">
        <h6 class="mb-3">Quick Links</h6>
        <ul class="list-unstyled">
          <li class="mb-2"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
          <li class="mb-2"><a href="/blog" class="text-white-50 text-decoration-none">Blog</a></li>
          <li class="mb-2"><a href="/about" class="text-white-50 text-decoration-none">About</a></li>
          <li class="mb-2"><a href="/contact" class="text-white-50 text-decoration-none">Contact</a></li>
        </ul>
      </div>
      <div class="col-lg-2 col-md-4">
        <h6 class="mb-3">Categories</h6>
        <ul class="list-unstyled">
          <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.slice(0, 5).forEach(function(cat) { %>
              <li class="mb-2"><a href="/category/<%= cat.slug %>" class="text-white-50 text-decoration-none"><%= cat.name %></a></li>
            <% }); %>
          <% } else { %>
            <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Aptitude</a></li>
            <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Reasoning</a></li>
            <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Math</a></li>
            <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">English</a></li>
          <% } %>
        </ul>
      </div>
      <div class="col-lg-2 col-md-4">
        <h6 class="mb-3">Account</h6>
        <ul class="list-unstyled">
          <% if (typeof user !== 'undefined' && user) { %>
            <li class="mb-2"><a href="/dashboard" class="text-white-50 text-decoration-none">Dashboard</a></li>
            <li class="mb-2"><a href="/profile/attempts" class="text-white-50 text-decoration-none">My Attempts</a></li>
            <li class="mb-2"><a href="/leaderboard" class="text-white-50 text-decoration-none">Leaderboard</a></li>
          <% } else { %>
            <li class="mb-2"><a href="/auth/login" class="text-white-50 text-decoration-none">Login</a></li>
            <li class="mb-2"><a href="/auth/register" class="text-white-50 text-decoration-none">Register</a></li>
            <li class="mb-2"><a href="/leaderboard" class="text-white-50 text-decoration-none">Leaderboard</a></li>
          <% } %>
        </ul>
      </div>
      <div class="col-lg-4 col-md-4">
        <h6 class="mb-3">Newsletter</h6>
        <p class="text-white-50 small">Subscribe to get the latest articles, quizzes, and updates.</p>
        <form class="d-flex" method="POST" action="/newsletter/subscribe">
          <%- include('csrf') %>
          <input type="email" class="form-control" name="email" placeholder="Enter your email" required autocomplete="email" data-trim-required="true" data-trim-message="Email is required." data-no-html-tags="true" data-no-html-message="Email cannot contain HTML or script tags." data-validate-disposable-email="true" data-disposable-message="Disposable email addresses are not allowed.">
          <button type="submit" class="btn btn-primary ms-2">Subscribe</button>
        </form>
        <% if (siteBrand.whatsappChannelUrl) { %>
          <a href="<%= siteBrand.whatsappChannelUrl %>" target="_blank" rel="noopener" class="btn btn-outline-success btn-sm mt-3">Join WhatsApp Channel</a>
        <% } %>
      </div>
    </div>
    <hr class="my-4 border-secondary">
    <div class="row align-items-center">
      <div class="col-md-6">
        <p class="small text-white-50 mb-0">&copy; <%= new Date().getFullYear() %> <%= siteBrand.copyrightText || siteBrand.siteName || 'Aptitude Booster Club' %>. All rights reserved.</p>
      </div>
      <div class="col-md-6 text-md-end">
        <a href="/admin" class="small text-white-50 text-decoration-none">Admin Panel</a>
      </div>
    </div>
  </div>
</footer>
