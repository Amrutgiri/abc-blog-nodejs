<header class="site-header">
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/">
        <%
          const siteBrand = typeof siteSettings !== 'undefined' && siteSettings ? siteSettings : {};
        %>
        <img src="<%= siteBrand.siteLogoUrl || '/images/headerlogo.png' %>" alt="<%= siteBrand.siteName || 'Aptitude Booster Club' %>" class="site-brand-logo" style="width: 150px;height: 65px;">
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/blog">Blog</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/quizzes">Quizzes</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/leaderboard">Leaderboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/about">About</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/contact">Contact</a>
          </li>
          <li class="nav-item ms-lg-3">
            <form class="d-flex position-relative" action="/search" method="GET" data-search-autocomplete>
              <input class="form-control form-control-sm" type="search" name="q" placeholder="Search..." aria-label="Search" autocomplete="off">
              <button class="btn btn-sm btn-outline-primary ms-2" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              </button>
              <div class="search-suggestions"></div>
            </form>
          </li>
          <% if (typeof user !== 'undefined' && user) { %>
            <li class="nav-item ms-lg-3 dropdown">
              <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="<%= user.avatar || '/images/default-avatar.png' %>" alt="<%= user.name || user.username || 'User' %>" class="rounded-circle border" width="34" height="34" style="object-fit: cover;">
                <span class="d-none d-md-inline text-start">
                  <span class="d-block fw-semibold lh-1"><%= user.name || user.username %></span>
                  <small class="text-muted"><%= user.email %></small>
                </span>
              </a>
              <div class="dropdown-menu dropdown-menu-end shadow-sm p-0 overflow-hidden" style="min-width: 260px;">
                <div class="p-3 border-bottom bg-light">
                  <div class="d-flex align-items-center gap-3">
                    <img src="<%= user.avatar || '/images/default-avatar.png' %>" alt="<%= user.name || user.username || 'User' %>" class="rounded-circle border" width="48" height="48" style="object-fit: cover;">
                    <div class="small">
                      <div class="fw-semibold text-dark"><%= user.name || user.username %></div>
                      <div class="text-muted"><%= user.email %></div>
                    </div>
                  </div>
                </div>
                <a class="dropdown-item py-2" href="/profile">
                  <i class="bi bi-person me-2"></i>My Profile
                </a>
                <a class="dropdown-item py-2" href="/dashboard">
                  <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </a>
                <a class="dropdown-item py-2" href="/profile/attempts">
                  <i class="bi bi-list-check me-2"></i>My Attempts
                </a>
                <% if (user.role === 'admin') { %>
                  <a class="dropdown-item py-2" href="/admin">
                    <i class="bi bi-shield-lock me-2"></i>Admin Panel
                  </a>
                <% } %>
                <div class="dropdown-divider mb-0"></div>
                <form method="POST" action="/auth/logout" class="m-0">
                  <%- include('./csrf') %>
                  <button class="dropdown-item py-2 text-danger" type="submit">
                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                  </button>
                </form>
              </div>
            </li>
          <% } else { %>
            <li class="nav-item ms-lg-3">
              <a class="btn btn-outline-primary btn-sm" href="/auth/login">Login</a>
            </li>
            <li class="nav-item ms-lg-2">
              <a class="btn btn-primary btn-sm" href="/auth/register">Register</a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
</header>
