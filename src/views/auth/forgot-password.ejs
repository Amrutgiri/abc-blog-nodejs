<div class="auth-page py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-5">
        <div class="card border-0 shadow-sm auth-card">
          <div class="card-body p-4 p-md-5">
            <h1 class="h3 fw-bold mb-2">Forgot password</h1>
            <p class="text-muted mb-4">We’ll email you a reset link if the account exists.</p>

            <form method="POST" action="/auth/forgot-password">
              <%- include('../partials/csrf') %>
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control form-control-lg" name="email" required autocomplete="email" data-trim-required="true" data-trim-message="Email is required." data-no-html-tags="true" data-no-html-message="Email cannot contain HTML or script tags.">
              </div>
              <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Send reset link</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
