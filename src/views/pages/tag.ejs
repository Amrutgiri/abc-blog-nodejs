

<div class="page-header py-5 bg-light">
  <div class="container">
    <h1 class="fw-bold">Tag: <%= tag.name %></h1>
    <nav aria-label="breadcrumb" class="mt-3">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/blog">Blog</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= tag.name %></li>
      </ol>
    </nav>
  </div>
</div>

<section class="tag-posts py-5">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <% if (posts && posts.length > 0) { %>
          <div class="row g-4">
            <% posts.forEach(function(post) { %>
              <div class="col-md-6">
                <article class="blog-card card h-100 border-0 shadow-sm">
                  <img src="<%= post.featuredImage || '/images/placeholder.jpg' %>" class="card-img-top" alt="<%= post.title %>" loading="lazy">
                  <div class="card-body">
                    <h5 class="card-title mb-2">
                      <a href="/blog/<%= post.slug %>" class="text-decoration-none text-dark"><%= post.title %></a>
                    </h5>
                    <p class="card-text text-muted mb-3"><%= post.excerpt ? post.excerpt.substring(0, 100) + '...' : '' %></p>
                  </div>
                </article>
              </div>
            <% }); %>
          </div>

          <% if (totalPages > 1) { %>
            <nav aria-label="Tag pagination" class="mt-5">
              <ul class="pagination justify-content-center">
                <% if (page > 1) { %>
                  <li class="page-item">
                    <a class="page-link" href="?page=<%= page - 1 %>">Previous</a>
                  </li>
                <% } %>
                <% for (var i = 1; i <= totalPages; i++) { %>
                  <li class="page-item <%= page === i ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                  </li>
                <% } %>
                <% if (page < totalPages) { %>
                  <li class="page-item">
                    <a class="page-link" href="?page=<%= page + 1 %>">Next</a>
                  </li>
                <% } %>
              </ul>
            </nav>
          <% } %>
        <% } else { %>
          <div class="text-center py-5">
            <h4 class="text-muted">No posts with this tag yet.</h4>
            <a href="/blog" class="btn btn-primary mt-3">Browse all posts</a>
          </div>
        <% } %>
      </div>

      <div class="col-lg-4">
        <div class="sidebar">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title mb-3">Categories</h5>
              <ul class="list-group list-group-flush">
                <% categories.forEach(function(cat) { %>
                  <li class="list-group-item px-0">
                    <a href="/category/<%= cat.slug %>" class="text-decoration-none">
                      <%= cat.name %>
                      <span class="badge bg-primary rounded-pill float-end"><%= cat.postCount || 0 %></span>
                    </a>
                  </li>
                <% }); %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>