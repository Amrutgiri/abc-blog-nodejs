

<div class="page-header py-5 bg-light">
  <div class="container">
    <h1 class="fw-bold">Blog</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Blog</li>
      </ol>
    </nav>
  </div>
</div>

<section class="blog-section py-5">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <% if (searchQuery) { %>
          <div class="alert alert-info mb-4">
            Showing results for: <strong><%= searchQuery %></strong>
            <a href="/blog" class="alert-link float-end">Clear search</a>
          </div>
        <% } %>

        <% if (posts && posts.length > 0) { %>
          <div class="row g-4">
            <% posts.forEach(function(post) { %>
              <div class="col-md-6">
                <article class="blog-card card h-100 border-0 shadow-sm">
                  <img src="<%= post.featuredImage || '/images/placeholder.jpg' %>" class="card-img-top" alt="<%= post.title %>" loading="lazy">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <% if (post.category) { %>
                        <a href="/category/<%= post.category.slug %>" class="badge bg-primary text-decoration-none"><%= post.category.name %></a>
                      <% } %>
                      <small class="text-muted"><%= post.views %> views</small>
                    </div>
                    <h5 class="card-title mb-2">
                      <a href="/blog/<%= post.slug %>" class="text-decoration-none text-dark"><%- post.highlightedTitle || post.title %></a>
                    </h5>
                    <p class="card-text text-muted mb-3"><%- post.highlightedExcerpt || (post.excerpt ? post.excerpt.substring(0, 100) + '...' : '') %></p>
                    <div class="d-flex align-items-center gap-2">
                      <% if (post.author) { %>
                        <img src="<%= post.author.avatar || '/images/default-avatar.png' %>" alt="<%= post.author.username %>" class="rounded-circle" width="24" height="24">
                        <small class="text-muted"><%= post.author.username %></small>
                      <% } %>
                      <span class="text-muted ms-auto"><%= post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '' %></span>
                    </div>
                  </div>
                </article>
              </div>
            <% }); %>
          </div>

          <% if (totalPages > 1) { %>
            <nav aria-label="Blog pagination" class="mt-5">
              <ul class="pagination justify-content-center">
                <% if (page > 1) { %>
                  <li class="page-item">
                    <a class="page-link" href="?page=<%= page - 1 %>">Previous</a>
                  </li>
                <% } %>
                <% for (var i = 1; i <= totalPages; i++) { %>
                  <li class="page-item <%= page === i ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                  </li>
                <% } %>
                <% if (page < totalPages) { %>
                  <li class="page-item">
                    <a class="page-link" href="?page=<%= page + 1 %>">Next</a>
                  </li>
                <% } %>
              </ul>
            </nav>
          <% } %>
        <% } else { %>
          <div class="text-center py-5">
            <h4 class="text-muted">No posts found.</h4>
            <% if (searchQuery) { %>
              <a href="/blog" class="btn btn-primary mt-3">Browse all posts</a>
            <% } %>
          </div>
        <% } %>
      </div>

      <div class="col-lg-4">
        <div class="sidebar">
          <div class="card mb-4 shadow-sm">
            <div class="card-body">
              <h5 class="card-title mb-3">Search</h5>
              <form action="/search" method="GET">
                <div class="input-group">
                  <input type="text" name="q" class="form-control" placeholder="Search posts..." minlength="2" required>
                  <button class="btn btn-primary" type="submit">Go</button>
                </div>
              </form>
            </div>
          </div>

          <div class="card mb-4 shadow-sm">
            <div class="card-body">
              <h5 class="card-title mb-3">Categories</h5>
              <ul class="list-group list-group-flush">
                <% if (categories && categories.length > 0) { %>
                  <% categories.forEach(function(cat) { %>
                    <li class="list-group-item px-0">
                      <a href="/category/<%= cat.slug %>" class="text-decoration-none d-flex justify-content-between align-items-center">
                        <%= cat.name %>
                        <span class="badge bg-primary rounded-pill"><%= cat.postCount || 0 %></span>
                      </a>
                    </li>
                  <% }); %>
                <% } %>
              </ul>
            </div>
          </div>

          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title mb-3">Popular Tags</h5>
              <div class="d-flex flex-wrap gap-2">
                <a href="#" class="badge bg-secondary">Aptitude</a>
                <a href="#" class="badge bg-secondary">Reasoning</a>
                <a href="#" class="badge bg-secondary">Math</a>
                <a href="#" class="badge bg-secondary">English</a>
                <a href="#" class="badge bg-secondary">Interview</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
