<div class="error-page py-5">
  <div class="container text-center">
    <h1 class="display-1 fw-bold text-danger"><%= statusCode %></h1>
    <h2 class="mb-4"><%= error %></h2>
    <p class="text-muted mb-4">Something went wrong. Please try again later.</p>
    <div class="d-flex justify-content-center gap-3">
      <a href="/" class="btn btn-primary">Go Home</a>
      <a href="/blog" class="btn btn-outline-primary">Browse Blog</a>
    </div>
  </div>
</div>