

<div class="page-header py-5 bg-light">
  <div class="container">
    <h1 class="fw-bold">About Us</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">About</li>
      </ol>
    </nav>
  </div>
</div>

<section class="about-section py-5">
  <div class="container">
    <%
      const siteBrand = typeof siteSettings !== 'undefined' && siteSettings ? siteSettings : {};
    %>
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h2 class="display-5 fw-bold mb-4">Welcome to <%= siteBrand.siteName || 'Aptitude Booster Club' %></h2>
        <p class="lead mb-4">We are dedicated to helping students and professionals improve their aptitude skills and excel in competitive exams.</p>
        <p class="text-muted mb-4">Our platform provides comprehensive resources for aptitude tests, reasoning puzzles, mathematical concepts, and verbal ability. Whether you're preparing for entrance exams, job interviews, or want to sharpen your skills, we've got you covered.</p>
        <div class="row g-3 mt-4">
          <div class="col-6">
            <div class="d-flex align-items-center gap-3">
              <div class="stat-icon bg-primary text-white rounded-circle p-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 3 12 14.01 9 11.01"></polyline></svg>
              </div>
              <div>
                <h4 class="mb-0 fw-bold">500+</h4>
                <small class="text-muted">Practice Questions</small>
              </div>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center gap-3">
              <div class="stat-icon bg-primary text-white rounded-circle p-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <div>
                <h4 class="mb-0 fw-bold">10K+</h4>
                <small class="text-muted">Active Users</small>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <img src="<%= siteBrand.siteLogoUrl || '/images/headerlogo.png' %>" alt="<%= siteBrand.siteName || 'About Us' %>" class="img-fluid rounded-3 shadow-lg">
      </div>
    </div>
  </div>
</section>

<section class="mission-section py-5 bg-light">
  <div class="container">
    <h2 class="text-center fw-bold mb-5">Our Mission</h2>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="mission-icon bg-primary text-white rounded-circle p-3 d-inline-block mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            </div>
            <h5 class="mb-3">Quality Content</h5>
            <p class="text-muted mb-0">We provide well-researched, accurate content that helps you learn effectively.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="mission-icon bg-primary text-white rounded-circle p-3 d-inline-block mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <h5 class="mb-3">Practice Daily</h5>
            <p class="text-muted mb-0">Regular practice is key to success. We encourage consistent daily practice.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body text-center p-4">
            <div class="mission-icon bg-primary text-white rounded-circle p-3 d-inline-block mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <h5 class="mb-3">Community Support</h5>
            <p class="text-muted mb-0">Join our community of learners and get support from experts.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
