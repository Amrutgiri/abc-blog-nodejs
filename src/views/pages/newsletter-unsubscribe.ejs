<div class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4 p-md-5 text-center">
            <% if (success) { %>
              <div class="mx-auto mb-4 d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success fw-bold" style="width:72px;height:72px;font-size:28px;">✓</div>
              <h1 class="h3 fw-bold mb-3">You are unsubscribed</h1>
              <p class="text-muted mb-4"><%= message %></p>
              <div class="alert alert-light border text-start mx-auto" style="max-width: 520px;">
                <strong>What happens next?</strong>
                <ul class="mb-0 mt-2">
                  <li>You will no longer receive blog or quiz announcement emails.</li>
                  <li>You can always subscribe again from the footer form.</li>
                  <li>Your account on the website is unchanged.</li>
                </ul>
              </div>
              <a href="/" class="btn btn-primary mt-3">Back to home</a>
            <% } else { %>
              <div class="mx-auto mb-4 d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger fw-bold" style="width:72px;height:72px;font-size:28px;">×</div>
              <h1 class="h3 fw-bold mb-3">Unable to unsubscribe</h1>
              <p class="text-muted mb-4"><%= message %></p>
              <a href="/" class="btn btn-outline-primary">Go back home</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
